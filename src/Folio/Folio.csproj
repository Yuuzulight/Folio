<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Parses HTML and CSS and lays out and paints single-file HTML documents.</Description>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Folio.Tests" />
    <InternalsVisibleTo Include="Folio.RenderTests" />
    <InternalsVisibleTo Include="Folio.Fuzz" />
    <InternalsVisibleTo Include="Folio.Benchmarks" />
    <!-- Folio's own host layer: the headless renderer and the control run the internal pipeline. -->
    <InternalsVisibleTo Include="Folio.Scripting" />
    <InternalsVisibleTo Include="Folio.Scripting.Tests" />
    <InternalsVisibleTo Include="Folio.Skia" />
    <InternalsVisibleTo Include="Folio.WinForms" />
    <InternalsVisibleTo Include="Folio.ContentHost" />
    <EmbeddedResource Include="Style\UserAgent.css" LogicalName="Folio.UserAgent.css" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../tests/fonts/SourceSans3-*.ttf;../../tests/fonts/SourceCodePro-*.ttf;../../tests/fonts/SourceSerif4-*.ttf;../../tests/fonts/Noto*.ttf;../../tests/fonts/Noto*.otf;../../tests/fonts/*-OFL.txt;../../tests/fonts/LICENSES.md;../../tests/fonts/SHA256SUMS"
             Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="fonts/%(Filename)%(Extension)" />
    <None Include="buildTransitive/Folio.targets" Pack="true" PackagePath="buildTransitive/Folio.targets" />
  </ItemGroup>
</Project>
