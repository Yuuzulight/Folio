<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Parses HTML and CSS and lays out and paints single-file HTML documents.</Description>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Folio.Tests" />
    <InternalsVisibleTo Include="Folio.RenderTests" />
    <InternalsVisibleTo Include="Folio.Fuzz" />
    <InternalsVisibleTo Include="Folio.Benchmarks" />
    <!-- Folio's own host layer: the headless renderer and the control run the internal pipeline. -->
    <InternalsVisibleTo Include="Folio.Skia" />
    <InternalsVisibleTo Include="Folio.WinForms" />
    <EmbeddedResource Include="Style\UserAgent.css" LogicalName="Folio.UserAgent.css" />
  </ItemGroup>

</Project>
