<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>FolioView, a WinForms control that shows a Folio document.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the solution build on Linux CI; the control only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Folio\Folio.csproj" />
    <ProjectReference Include="..\Folio.Skia\Folio.Skia.csproj" />
  </ItemGroup>

</Project>
