<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Script engine abstraction, script values, limits, host object templates and evaluation results.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Folio\Folio.csproj" />
    <ProjectReference Include="..\Folio.Diagrams\Folio.Diagrams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ANGLE and Wasmtime are explicit differential oracles only. Production
         projects must not reference or package compatibility runtimes at all. -->
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" Condition="'$(FolioAngleOracle)' == 'true'" />
    <PackageReference Include="Wasmtime" Version="48.0.2" Condition="'$(FolioWasmOracle)' == 'true'" />
  </ItemGroup>

  <!-- The production NativeAOT host accepts explicit wire contracts only. The normal SDK keeps its JIT fallback. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);FOLIO_NATIVE_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(FolioAngleOracle)' != 'true'">
    <Compile Remove="Gpu/Angle*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(FolioAngleOracle)' == 'true'">
    <DefineConstants>$(DefineConstants);FOLIO_ANGLE_ORACLE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FolioWasmOracle)' == 'true'">
    <DefineConstants>$(DefineConstants);FOLIO_WASM_ORACLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Folio.Scripting.Tests" />
    <InternalsVisibleTo Include="Folio.Scripting.Jint" />
    <InternalsVisibleTo Include="Folio.ContentHost" />
    <InternalsVisibleTo Include="Folio.RenderTests" />
    <InternalsVisibleTo Include="Folio.Fuzz" />
    <InternalsVisibleTo Include="Folio.Benchmarks" />
  </ItemGroup>

</Project>
