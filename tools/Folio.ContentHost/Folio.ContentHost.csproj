<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The production script publishes a standalone native executable from isolated intermediates.
         Ordinary solution builds remain managed for tests and explicit oracle builds. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FolioOracleHost)' == 'true'">
    <DefineConstants>$(DefineConstants);FOLIO_ORACLE_HOST</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FolioAngleOracle)' == 'true'">
    <DefineConstants>$(DefineConstants);FOLIO_ANGLE_ORACLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Folio.Scripting\Folio.Scripting.csproj" />
    <!-- Only the CI/differential oracle host includes Jint. Production publish leaves it out. -->
    <ProjectReference Include="..\..\src\Folio.Scripting.Jint\Folio.Scripting.Jint.csproj" Condition="'$(FolioOracleHost)' == 'true'" />
    <ProjectReference Include="..\..\src\Folio\Folio.csproj" />
    <ProjectReference Include="..\..\src\Folio.Diagrams\Folio.Diagrams.csproj" />
  </ItemGroup>
</Project>
