<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The M4 cold-start gate explicitly requires ReadyToRun for the first
         content-process paint; keep the production host on the same path used
         by the benchmark and shipped Windows apphost. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Folio.Scripting\Folio.Scripting.csproj" />
    <ProjectReference Include="..\..\src\Folio.Scripting.Jint\Folio.Scripting.Jint.csproj" />
    <ProjectReference Include="..\..\src\Folio\Folio.csproj" />
    <ProjectReference Include="..\..\src\Folio.Skia\Folio.Skia.csproj" />
    <ProjectReference Include="..\..\src\Folio.Diagrams\Folio.Diagrams.csproj" />
  </ItemGroup>
</Project>
