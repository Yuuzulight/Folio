<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publish through tools/publish-content-host.ps1: its isolated build path
         prevents stale composite images from contaminating this non-composite host. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Folio.Scripting\Folio.Scripting.csproj" />
    <!-- Only the CI/differential oracle host includes Jint. Production publish leaves it out. -->
    <ProjectReference Include="..\..\src\Folio.Scripting.Jint\Folio.Scripting.Jint.csproj" Condition="'$(FolioOracleHost)' == 'true'" />
    <ProjectReference Include="..\..\src\Folio\Folio.csproj" />
    <ProjectReference Include="..\..\src\Folio.Diagrams\Folio.Diagrams.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../tests/fonts/SourceSans3-*.ttf;../../tests/fonts/SourceCodePro-*.ttf;../../tests/fonts/SourceSerif4-*.ttf;../../tests/fonts/Noto*.ttf;../../tests/fonts/Noto*.otf;../../tests/fonts/*-OFL.txt;../../tests/fonts/LICENSES.md;../../tests/fonts/SHA256SUMS"
             Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
