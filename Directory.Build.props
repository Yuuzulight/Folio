<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Packages (tools/pack.ps1). Only the libraries under src/ pack. The version is 0.1.0-m1.N, where N is the
       build number the script passes: the number of commits in the packed commit's history. -->
  <PropertyGroup>
    <FolioBuild Condition="'$(FolioBuild)' == ''">0</FolioBuild>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>m1.$(FolioBuild)</VersionSuffix>
    <IsPackable>false</IsPackable>
    <Authors>Yuuzulight</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Yuuzulight/Folio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Yuuzulight/Folio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
