enum AlignMode {
    "start",
    "center",
    "end"
};

dictionary PointOptions {
    required double x;
    double y = 0.0;
    DOMString label = "default";
};

interface TestNode {
    const unsigned short ELEMENT_NODE = 1;
    readonly attribute DOMString nodeName;
    attribute DOMString? textContent;
};

interface TestElement : TestNode {
    attribute boolean active;
    attribute double score;
    attribute [EnforceRange] long priority;
    attribute [Clamp] octet level;
    attribute USVString unicodeText;

    DOMString greet(DOMString name, optional DOMString title = "Mx.");
    long compute(long x);
    long compute(long x, long y);
    void reset();
};

dictionary ConversionOptions {
    required long requiredValue;
    DOMString label = "fallback";
};

interface ConversionProbe {
    readonly attribute long? changing;
    [SameObject] readonly attribute ConversionProbe first;
    [SameObject] readonly attribute ConversionProbe second;
    ConversionProbe echo(ConversionProbe value);
    long consumeOptions(ConversionOptions options);
    ConversionOptions echoOptions(ConversionOptions options);
    boolean consumeBoolean(boolean value);
    sequence<float> consumeFloats(Float32List values);
    BufferSource consumeBuffer(BufferSource value);
    Float32Array consumeFloat32(Float32Array value);
    long upload(unsigned long target, long size, unsigned long usage);
    long upload(unsigned long target, BufferSource? data, unsigned long usage);
    long requiredOptional(long requiredValue, optional long optionalValue = 7);
};
