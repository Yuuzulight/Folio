<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- The test assembly exercises both Folio's runtime and the explicit
         Wasmtime differential oracle; production projects keep oracle assets out. -->
    <FolioWasmOracle>true</FolioWasmOracle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="48.0.2" Condition="'$(FolioWasmOracle)' == 'true'" />
    <ProjectReference Include="..\..\src\Folio\Folio.csproj" />
    <ProjectReference Include="..\..\src\Folio.Scripting\Folio.Scripting.csproj" />
    <ProjectReference Include="..\..\src\Folio.Diagrams\Folio.Diagrams.csproj" />
    <ProjectReference Include="..\..\src\Folio.Skia\Folio.Skia.csproj" />
    <ProjectReference Include="..\..\src\Folio.Scripting.Jint\Folio.Scripting.Jint.csproj" />
    <ProjectReference Include="..\..\tools\Folio.Gen\Folio.Gen.csproj" />
  </ItemGroup>

  <!-- The Wasmtime differential tests are only meaningful in the explicit
       oracle matrix; production builds must compile without the oracle types. -->
  <ItemGroup Condition="'$(FolioWasmOracle)' != 'true'">
    <Compile Remove="NativeWebAssemblyTests.cs" />
  </ItemGroup>

  <!-- Exercise the exact native adapters on Windows CI without loading Windows Forms on Linux. -->
  <ItemGroup>
    <Compile Include="..\..\src\Folio.WinForms\ContentCommandQueue.cs" Link="Native\ContentCommandQueue.cs" />
    <Compile Include="..\..\src\Folio.WinForms\MediaFoundationAudioDecoder.cs" Link="Native\MediaFoundationAudioDecoder.cs" />
    <Compile Include="..\..\src\Folio.WinForms\WinMmMediaAudioOutput.cs" Link="Native\WinMmMediaAudioOutput.cs" />
    <None Include="Native\Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Native\Fixtures\WebGl\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
