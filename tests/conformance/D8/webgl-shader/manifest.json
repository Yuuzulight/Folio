{
  "prompt": "Build a WebGL shader playground with a gradient shader and a reset button.",
  "features": [
    "script",
    "webgl2",
    "fragment-shader",
    "interaction"
  ],
  "viewport": 800,
  "interaction": [
    "exists #glcanvas",
    "text #mode-name plasma",
    "click #mode-btn",
    "text #mode-name aurora",
    "click #reset-btn",
    "text #mode-name plasma"
  ]
}
