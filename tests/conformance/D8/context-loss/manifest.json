{
  "prompt": "Render a WebGL scene that reports context loss and restoration to the user.",
  "features": [
    "script",
    "webgl",
    "context-lost",
    "context-restored"
  ],
  "viewport": 800,
  "interaction": [
    "exists #glcanvas",
    "text #status active",
    "click #lose-btn",
    "text #status lost",
    "click #restore-btn",
    "text #status restored"
  ]
}
