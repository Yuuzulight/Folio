{
  "prompt": "Create a desktop calculator supporting basic arithmetic (+, -, *, /), decimals, clear, and equals. Displays the current calculation and running total.",
  "features": [
    "script",
    "dom-events",
    "grid",
    "flex",
    "forms",
    "keyboard",
    "custom-properties"
  ],
  "viewport": 800,
  "interaction": [
    "exists #calc-display",
    "text #calc-display 0",
    "click button[data-val='7']",
    "click button[data-op='+']",
    "click button[data-val='5']",
    "click button[data-action='equals']",
    "text #calc-display 12",
    "click button[data-action='clear']",
    "text #calc-display 0"
  ]
}
