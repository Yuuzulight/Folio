{
  "prompt": "Build a classic to-do list application backed by localStorage: add new items, toggle completed state, filter by All / Active / Completed, clear completed items, and display item counts.",
  "features": [
    "script",
    "dom-events",
    "localstorage",
    "forms",
    "flex",
    "aria",
    "custom-properties"
  ],
  "viewport": 800,
  "interaction": [
    "exists #todo-input",
    "exists #todo-list",
    "type #todo-input Buy groceries",
    "click #btn-add-todo",
    "exists .todo-item",
    "text #todo-count 1 item left",
    "click .todo-checkbox",
    "text #todo-count 0 items left",
    "click #filter-completed",
    "exists .todo-item",
    "click #filter-active",
    "text #todo-count 0 items left",
    "click #btn-clear-completed"
  ]
}
