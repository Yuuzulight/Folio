{
  "prompt": "Create a registration form with live constraint validation: required username, email format, password min-length 8, password confirmation, and terms checkbox. Show field error badges and disable/enable submission.",
  "features": [
    "script",
    "dom-events",
    "forms",
    "aria",
    "flex",
    "custom-properties"
  ],
  "viewport": 800,
  "interaction": [
    "exists #reg-form",
    "exists #btn-submit",
    "type #username user1",
    "type #email invalid-email",
    "click #btn-submit",
    "exists #email-error:not([hidden])",
    "type #email test@example.com",
    "type #password secret123",
    "type #confirm secret123",
    "click #terms",
    "click #btn-submit",
    "exists #success-msg:not([hidden])"
  ]
}
