{
  "prompt": "Design a confirmation dialog modal using plain HTML/CSS elements without the <dialog> element. Includes a semi-transparent backdrop, focus trapping, Escape key listener to close, and Confirm/Cancel buttons updating an action log.",
  "features": [
    "script",
    "dom-events",
    "aria",
    "hidden-attribute",
    "keyboard",
    "flex",
    "custom-properties"
  ],
  "viewport": 800,
  "interaction": [
    "exists #btn-open-modal",
    "exists #modal-overlay[hidden]",
    "click #btn-open-modal",
    "exists #modal-overlay:not([hidden])",
    "text #modal-title Confirm Deletion",
    "click #btn-modal-cancel",
    "exists #modal-overlay[hidden]",
    "text #action-status Cancelled",
    "click #btn-open-modal",
    "click #btn-modal-confirm",
    "exists #modal-overlay[hidden]",
    "text #action-status Confirmed"
  ]
}
