{
  "prompt": "Create an auto-advancing testimonials carousel with timer transitions, Previous / Next controls, dot indicator navigation, and pause on mouse hover.",
  "features": [
    "script",
    "dom-events",
    "timers",
    "aria",
    "flex",
    "transitions",
    "custom-properties"
  ],
  "viewport": 800,
  "interaction": [
    "exists #carousel",
    "exists .dot.active",
    "text #slide-title Slide One: Fast Execution",
    "click #btn-next",
    "text #slide-title Slide Two: Sandboxed Security",
    "click #btn-prev",
    "text #slide-title Slide One: Fast Execution",
    "click button[data-slide='2']",
    "text #slide-title Slide Three: Spec Fidelity"
  ]
}
