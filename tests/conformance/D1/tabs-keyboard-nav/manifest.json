{
  "prompt": "A tabbed content interface implementing the WAI-ARIA tabs design pattern with full keyboard navigation: ArrowLeft/ArrowRight to switch tabs, Home for first tab, End for last tab, and automatic panel synchronization.",
  "features": [
    "script",
    "dom-events",
    "aria",
    "keyboard",
    "flex",
    "hidden-attribute",
    "custom-properties"
  ],
  "viewport": 800,
  "interaction": [
    "exists #tab-overview",
    "exists #panel-overview:not([hidden])",
    "click #tab-analytics",
    "exists #panel-analytics:not([hidden])",
    "exists #panel-overview[hidden]",
    "click #tab-reports",
    "exists #panel-reports:not([hidden])",
    "key Home",
    "click #tab-overview",
    "exists #panel-overview:not([hidden])"
  ]
}
